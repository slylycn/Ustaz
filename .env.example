# Copy this file to .env.local and fill in the values.

# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon key (eyJ...) or the newer publishable key (sb_publishable_...). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" only after Google is enabled in Supabase → Authentication → Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Admin: the one email allowed to create and edit platform rubrics. Server-only.
ADMIN_EMAIL=you@example.com
# Supabase → Project Settings → API keys → service_role (or the newer secret key, sb_secret_...).
# Server-only and powerful: it bypasses RLS. Used only for the admin's platform-rubric edits.
# Never prefix with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Aqylbek (Gemini). Server-only: never prefix with NEXT_PUBLIC_.
# Key: Google AI Studio → Get API key.
GEMINI_API_KEY=
# Model id as listed in Google AI Studio, e.g. a current Flash model.
GEMINI_MODEL=
